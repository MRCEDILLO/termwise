rules_version = '2';

// Termwise Storage rules: lesson files.
// Files live at classes/{classId}/files/{fileId}/{name}. Their record in Firestore
// (classes/{classId}/files/{fileId}) says whether the file is teacher-only and when it unlocks,
// and the app copies those settings onto the file's custom metadata, which is what these rules read.
// Only the class's teacher (while still on the admin's list) can upload or delete. Students who joined with the current key can
// read a file once it is open: not teacher-only, switched on, or past its unlock date.
service firebase.storage {
  match /b/{bucket}/o {

    function classData(classId) {
      return firestore.get(/databases/(default)/documents/classes/$(classId)).data;
    }

    // A Google account on the admin's teacher list, or the admin (as in firestore.rules).
    function isTeacher() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && (request.auth.token.email.lower() == 'gabrielcedillo2002@gmail.com'
            || firestore.exists(/databases/(default)/documents/allowedTeachers/$(request.auth.token.email.lower())));
    }

    function isOwner(classId) {
      return isTeacher() && classData(classId).owner == request.auth.uid;
    }

    // Is the file open to students? The lock settings are read from the file's own metadata
    // (written by the app alongside the Firestore record), not from Firestore: Storage rules may
    // look at no more than two Firestore documents per request, and canOpen already uses two
    // (the class and the student's membership). A third lookup makes Firebase refuse every
    // student. A file with no settings on it counts as locked until the teacher's app adds them.
    function isOpen() {
      let md = resource.metadata == null ? {} : resource.metadata;
      let unlockAt = md.get('unlockAt', '');
      return md.get('locked', 'true') == 'false'
        || md.get('unlocked', 'false') == 'true'
        || (unlockAt.matches('^[0-9]+$') && request.time.toMillis() >= int(unlockAt));
    }

    // PDF, PowerPoint, Word and common pictures, up to 50 MB (see files.js).
    function allowedUpload() {
      return request.resource.size > 0 && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|application/vnd[.]openxmlformats-officedocument[.](presentationml[.]presentation|wordprocessingml[.]document)|image/(png|jpeg|gif|webp)');
    }

    // Who may open a file. Written so that each kind of reader costs at most two Firestore
    // documents (the limit above): the class's teacher (class + teacher list), another teacher
    // copying the class with its key (class + their importers record) and a student (class +
    // membership). An importer may open every file, teacher-only ones too, because a copy of a
    // class brings those across. The importers record can only be written by someone on the
    // teacher list (firestore.rules), so the list isn't read again here.
    function canOpen(classId) {
      let c = classData(classId);
      let uid = request.auth.uid;
      let imp = /databases/(default)/documents/classes/$(classId)/importers/$(uid);
      let m = /databases/(default)/documents/classes/$(classId)/members/$(uid);
      return (c.owner == uid && isTeacher())
        || (c.owner != uid && c.archived == false
            && request.auth.token.firebase.sign_in_provider == 'google.com'
            && request.auth.token.email_verified == true
            && firestore.exists(imp) && firestore.get(imp).data.key == c.currentKey)
        || (c.owner != uid && c.archived == false
            && firestore.exists(m) && firestore.get(m).data.key == c.currentKey && isOpen());
    }

    match /classes/{classId}/files/{fileId}/{fileName} {
      allow read: if request.auth != null && canOpen(classId);
      allow create, update: if isOwner(classId) && allowedUpload();
      allow delete: if isOwner(classId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
