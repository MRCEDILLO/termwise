rules_version = '2';

// Termwise Firestore rules. These are the real lock: the website's code is public,
// so every read and write is checked here.
//
// Teachers sign in with Google, and only the admin and the emails on the admin's list
// (allowedTeachers/{email}) count as teachers. Students get a silent anonymous sign-in and become a
// member of a class by writing the class's current key into classes/{id}/members/{uid}.
// Regenerating the key or archiving the class cuts every member off at once.
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */

    function signedIn() {
      return request.auth != null;
    }

    function isGoogle() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // The admin's Google account. Also in config.js (ADMIN_EMAIL) and storage.rules.
    function isAdmin() {
      return isGoogle() && request.auth.token.email_verified == true
        && myEmail() == 'gabrielcedillo2002@gmail.com';
    }

    // A Google account the admin has let in (or the admin).
    function isTeacher() {
      return isAdmin() || (isGoogle()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowedTeachers/$(myEmail())));
    }

    function classPath(classId) {
      return /databases/$(database)/documents/classes/$(classId);
    }

    function isOwner(classId) {
      return isTeacher() && get(classPath(classId)).data.owner == request.auth.uid;
    }

    function isMember(classId) {
      let c = get(classPath(classId)).data;
      let m = /databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid);
      return signedIn() && c.archived == false && exists(m) && get(m).data.key == c.currentKey;
    }

    // A teacher copying this class into a new class of their own, using the class's copy key
    // (see importers below). They can read the lesson library and files, nothing else. The copy key
    // is separate from the key students join with, and a class has none until its teacher turns
    // sharing on, so a student key on the board never lets another teacher in.
    function isImporter(classId) {
      let c = get(classPath(classId)).data;
      let m = /databases/$(database)/documents/classes/$(classId)/importers/$(request.auth.uid);
      return isTeacher() && c.archived == false && validKey(c.get('copyKey', ''))
        && exists(m) && get(m).data.key == c.get('copyKey', '');
    }

    // 8 characters with no look-alikes (no 0, O, 1, I, L).
    function validKey(k) {
      return k is string && k.matches('^[A-HJKMNP-Z2-9]{8}$');
    }

    function validClass(d) {
      return d.keys().hasOnly(['name', 'subject', 'year', 'owner', 'currentKey', 'copyKey', 'archived', 'colour', 'createdAt', 'teacher', 'contact', 'about'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.subject is string && d.subject.size() <= 80
        && d.year is string && d.year.size() <= 20
        && d.archived is bool
        && validKey(d.currentKey)
        // Set only while the teacher lets other teachers copy the class.
        && (!('copyKey' in d) || d.copyKey == null || validKey(d.copyKey))
        && (!('colour' in d) || (d.colour is int && d.colour >= 0 && d.colour < 32))
        && (!('createdAt' in d) || d.createdAt is timestamp || d.createdAt is int)
        // Shown to students on the class home page.
        && (!('teacher' in d) || (d.teacher is string && d.teacher.size() <= 80))
        && (!('contact' in d) || (d.contact is string && d.contact.size() <= 200))
        && (!('about' in d) || (d.about is string && d.about.size() <= 1000));
    }

    // The key lookup a class points at must point back at that same class, so one
    // teacher can't set their class's key to a key another class already uses.
    function keyIsFor(key, classId) {
      return getAfter(/databases/$(database)/documents/joinKeys/$(key)).data.classId == classId;
    }

    // The same for the copy key: null (sharing off), or a copyKeys lookup pointing back at this class.
    function copyKeyOk(d, classId) {
      return d.get('copyKey', null) == null
        || getAfter(/databases/$(database)/documents/copyKeys/$(d.copyKey)).data.classId == classId;
    }

    function validFile(d) {
      return d.keys().hasOnly(['lessonId', 'name', 'size', 'type', 'locked', 'unlocked', 'unlockAt', 'createdAt'])
        && d.lessonId is string && d.lessonId.size() > 0
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.size is int && d.size > 0 && d.size <= 50 * 1024 * 1024
        && d.type is string
        && d.locked is bool && d.unlocked is bool
        && (d.unlockAt == null || d.unlockAt is timestamp);
    }

    /* ---------- teachers ---------- */

    // The admin's list of teacher emails (lower case, one doc each). A Google account can check
    // whether its own email is on it; only the admin sees or changes the whole list.
    match /allowedTeachers/{email} {
      allow get: if isAdmin() || (isGoogle() && request.auth.token.email_verified == true && myEmail() == email);
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin()
        && email == email.lower()
        && email.matches('^[^@\\s/]+@[^@\\s/]+[.][^@\\s/]+$')
        && request.resource.data.keys().hasOnly(['addedAt'])
        && request.resource.data.addedAt is int;
    }

    match /teachers/{uid} {
      allow read, write: if isTeacher() && request.auth.uid == uid;
    }

    /* ---------- class keys ---------- */

    // Anyone signed in can look up one exact key. Listing keys is never allowed.
    match /joinKeys/{key} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isTeacher()
        && validKey(key)
        && request.resource.data.keys().hasOnly(['classId', 'owner'])
        && request.resource.data.owner == request.auth.uid
        && getAfter(classPath(request.resource.data.classId)).data.owner == request.auth.uid
        && getAfter(classPath(request.resource.data.classId)).data.currentKey == key;
      allow update: if false;
      allow delete: if isTeacher() && resource.data.owner == request.auth.uid;
    }

    // Copy keys: how another teacher finds a class to copy. Only teachers may look one up.
    match /copyKeys/{key} {
      allow get: if isTeacher();
      allow list: if false;
      allow create: if isTeacher()
        && validKey(key)
        && request.resource.data.keys().hasOnly(['classId', 'owner'])
        && request.resource.data.owner == request.auth.uid
        && getAfter(classPath(request.resource.data.classId)).data.owner == request.auth.uid
        && getAfter(classPath(request.resource.data.classId)).data.get('copyKey', null) == key;
      allow update: if false;
      allow delete: if isTeacher() && resource.data.owner == request.auth.uid;
    }

    /* ---------- classes ---------- */

    match /classes/{classId} {
      allow get: if (isTeacher() && resource.data.owner == request.auth.uid) || isMember(classId) || isImporter(classId);
      allow list: if isTeacher() && resource.data.owner == request.auth.uid;
      allow create: if isTeacher()
        && request.resource.data.owner == request.auth.uid
        && validClass(request.resource.data)
        && keyIsFor(request.resource.data.currentKey, classId)
        && copyKeyOk(request.resource.data, classId);
      allow update: if isTeacher()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && validClass(request.resource.data)
        && (request.resource.data.currentKey == resource.data.currentKey
            || keyIsFor(request.resource.data.currentKey, classId))
        && (request.resource.data.get('copyKey', null) == resource.data.get('copyKey', null)
            || copyKeyOk(request.resource.data, classId));
      allow delete: if isTeacher() && resource.data.owner == request.auth.uid;

      // A student's membership: just the key they joined with.
      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isOwner(classId));
        allow list: if isOwner(classId);
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['key', 'joinedAt'])
          && (!('joinedAt' in request.resource.data) || request.resource.data.joinedAt is int)
          && get(classPath(classId)).data.archived == false
          && request.resource.data.key == get(classPath(classId)).data.currentKey;
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(classId));
      }

      // Another teacher copying this class, with the copy key they typed in (like a membership, but
      // for teachers). It only lets them read units, lessons and files, and the app deletes it once
      // the copy is done. A new copy key, turning sharing off or archiving the class cuts it off.
      match /importers/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isOwner(classId));
        allow list: if isOwner(classId);
        allow create, update: if isTeacher()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['key', 'at'])
          && (!('at' in request.resource.data) || request.resource.data.at is int)
          && get(classPath(classId)).data.archived == false
          && validKey(request.resource.data.key)
          && request.resource.data.key == get(classPath(classId)).data.get('copyKey', '');
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(classId));
      }

      // What students may read: the plan, units, lessons and announcements.
      match /plan/{doc} {
        allow read: if isOwner(classId) || isMember(classId);
        allow write: if isOwner(classId);
      }
      match /units/{unitId} {
        allow read: if isOwner(classId) || isMember(classId) || isImporter(classId);
        allow write: if isOwner(classId);
      }
      match /lessons/{lessonId} {
        allow read: if isOwner(classId) || isMember(classId) || isImporter(classId);
        allow write: if isOwner(classId);
      }
      match /announcements/{postId} {
        allow read: if isOwner(classId) || isMember(classId);
        allow create, update: if isOwner(classId)
          && request.resource.data.keys().hasOnly(['text', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000;
        allow delete: if isOwner(classId);
      }

      // Lesson files. Students can see every file's record (so a teacher-only file can say when
      // it unlocks); storage.rules decides whether they can open the file itself.
      match /files/{fileId} {
        allow read: if isOwner(classId) || isMember(classId) || isImporter(classId);
        allow create, update: if isOwner(classId) && validFile(request.resource.data);
        allow delete: if isOwner(classId);
      }

      // Everything else (students, marks) is owner only.
      match /{sub}/{docId=**} {
        allow read, write: if isOwner(classId)
          && !(sub in ['members', 'importers', 'plan', 'units', 'lessons', 'announcements', 'files']);
      }
    }
  }
}
