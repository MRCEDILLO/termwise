{
  "name": "termwise-tests",
  "private": true,
  "type": "module",
  "description": "Developer tests only. The website itself has no build step and no npm.",
  "scripts": {
    "test:planner": "node --test planner.test.js",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-termwise \"node --test rules.test.js\"",
    "test:store": "firebase emulators:exec --config ../firebase.json --only firestore,auth --project demo-termwise \"node --test --test-force-exit store.test.js\"",
    "test": "npm run test:planner && npm run test:rules && npm run test:store"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0"
  }
}
